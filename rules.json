[
  {
    "match": {
      "patterns": ["*_tg.*"],
      "events": ["Created", "Renamed", "Init"]
    },
    "actions": [
      { "type": "sendToTelegram", "sendMethod": "file" },
      { "type": "removePattern", "pattern": "_tg" }
    ],
    "stopOnMatch": true
  },
  {
    "match": {
      "patterns": ["*_tgt.*"],
      "events": ["Created", "Renamed", "Init"]
    },
    "actions": [
      { "type": "sendToTelegram", "sendMethod": "txt" },
      { "type": "removePattern", "pattern": "_tgt" }
    ],
    "stopOnMatch": true
  },
  {
    "match": {
      "patterns": ["*cv*"],
      "events": ["Created", "Renamed", "Init"]
    },
    "actions": [
      { "type": "moveTo", "destination": "C:\\Users\\Birka\\OneDrive\\Documents\\My Documents\\CVs" }
    ],
    "stopOnMatch": true
  }
]